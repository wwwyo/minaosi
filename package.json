{
  "name": "minaosi",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/extension dev",
    "build": "bun run --cwd apps/extension build",
    "zip": "bun run --cwd apps/extension zip",
    "check": "bun run --cwd apps/api check && bun run --cwd apps/extension check",
    "test": "bun test apps",
    "api:dev": "bun run --cwd apps/api dev",
    "api:build": "bun run --cwd apps/api build",
    "api:deploy": "bun run --cwd apps/api deploy",
    "api:worker:dev": "bun run --cwd apps/api dev:gateway"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
